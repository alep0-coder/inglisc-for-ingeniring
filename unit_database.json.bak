    {
      "id": "unit_24",
      "title": "Unit 24: Machining 2",
      "lessons": [
        {
          "id": "u24_l1",
          "title": "Guillotining and punching",
          "theory": "Cutting thin materials using pressure (**shear force**):\n\n* **Guillotining**: Making long, straight cuts with a blade.\n* **Punching**: Using a **die** to make small, shaped cuts.\n* **Blanking**: Producing small, shaped workpieces (**blanks**) from a sheet.\n* **Piercing**: Making holes in a sheet where the sheet is the final product.",
          "exercises": [
            {
              "type": "multiple_choice",
              "question": "What is producing small shaped workpieces from a sheet called?",
              "options": [
                {
                  "text": "Punching",
                  "is_correct": false
                },
                {
                  "text": "Blanking",
                  "is_correct": true
                },
                {
                  "text": "Piercing",
                  "is_correct": false
                }
              ],
              "explanation": "Blanking produces workpieces; piercing makes holes in a product."
            },
            {
              "type": "multiple_choice",
              "question": "Making long straight cuts with a blade is:",
              "options": [
                {
                  "text": "Guilloting",
                  "is_correct": true
                },
                {
                  "text": "Punching",
                  "is_correct": false
                },
                {
                  "text": "Blanking",
                  "is_correct": false
                }
              ],
              "explanation": "Guilloting uses shear force for straight cuts."
            },
            {
              "type": "multiple_choice",
              "question": "What is making holes in a product called?",
              "options": [
                {
                  "text": "Blanking",
                  "is_correct": false
                },
                {
                  "text": "Piercing",
                  "is_correct": true
                },
                {
                  "text": "Guilloting",
                  "is_correct": false
                }
              ],
              "explanation": "Piercing involves punching holes in a sheet."
            }
          ]
        },
        {
          "id": "u24_l2",
          "title": "High-temperature and waterjet cutting",
          "theory": "Advanced cutting technologies:\n\n* **Flame-cutting**: Using **oxyacetylene** (oxygen + acetylene) to melt steel.\n* **EDM (Electrical Discharge Machining)**: Also called **spark erosion**; using an **electric arc** to melt metal ahead of a wire.\n* **Plasma cutting**: Using **ionized** gas (plasma) at extremely high temperatures.\n* **Laser cutting**: Using concentrated light to melt material.\n* **UHP Waterjet**: Using extremely high-pressure water. Advantage: no **HAZ** (heat-affected zone) and no **secondary operations** needed.",
          "exercises": [
            {
              "type": "matching",
              "question": "Match the cutting technology:",
              "pairs": [
                {
                  "left": "Flame-cutting",
                  "right": "Uses oxyacetylene"
                },
                {
                  "left": "EDM",
                  "right": "Spark erosion using electric arc"
                },
                {
                  "left": "Waterjet",
                  "right": "No heat-affected zone (HAZ)"
                }
              ],
              "explanation": "Advanced cutting methods offer high precision and handle different materials."
            },
            {
              "type": "fill_in_the_blank",
              "question": "EDM stands for (1) ____. Ionized gas is (2) ____. Area changed by heat is (3) ____.",
