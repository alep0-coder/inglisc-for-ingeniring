    {
      "id": "unit_27",
      "title": "Unit 27: Mechanical fasteners 2",
      "lessons": [
        {
          "id": "u27_l1",
          "title": "Screws and anchors",
          "theory": "Screws and wall fixings:\n\n* **Self-tapping screws**: Cut their own holes without predrilling.\n* **Machine screws**: Small-diameter bolts used with nuts or threaded holes.\n* **Set screws** (**grub screws**): Hold components in place by pressure (e.g., a wheel on a shaft).\n* **Screw anchors** (**wall plugs**): Expand in a hole to resist **pullout forces**.\n* **Chemical anchors**: Studs set in a hole using **epoxy resin**.",
          "exercises": [
            {
              "type": "matching",
              "question": "Match the screw/anchor type:",
              "pairs": [
                {
                  "left": "Self-tapping screw",
                  "right": "Cuts its own hole"
                },
                {
                  "left": "Set screw",
                  "right": "Grub screw; holds parts by pressure"
                },
                {
                  "left": "Chemical anchor",
                  "right": "Uses epoxy resin"
                }
              ],
              "explanation": "Screws and anchors are chosen based on the base material."
            },
            {
              "type": "fill_in_the_blank",
              "question": "Wall plugs (1) ____ to resist (2) ____ force. (3) ____ screws cut their own holes.",
              "blanks": [
                {
                  "position": 1,
                  "answer": "expand"
                },
                {
                  "position": 2,
                  "answer": "pullout"
                },
                {
                  "position": 3,
                  "answer": "Self-tapping"
                }
              ],
              "accepted_answers": [
                [
                  "expand",
                  "pullout",
                  "Self-tapping"
                ]
              ],
              "explanation": "Textbook 27.1 verification."
            },
            {
              "type": "multiple_choice",
              "question": "Which screw is also called a grub screw?",
              "options": [
                {
                  "text": "Self-tapping screw",
                  "is_correct": false
                },
                {
                  "text": "Set screw",
                  "is_correct": true
                },
                {
                  "text": "Coach screw",
                  "is_correct": false
                }
              ],
              "explanation": "Set screws (grub screws) hold parts by pressure."
            }
          ]
        },
        {
          "id": "u27_l2",
          "title": "Rivets",
          "theory": "Permanent fasteners:\n\n* **Solid rivets**: Consist of a shaft with a **factory head**. A tool deforms the other end to form a **shop head**.\n* **Blind rivets** (**pop rivets**): Hollow tubes fitted using a **rivet gun** from one side only.\n* **Rivet gun**: The tool used to install blind rivets.",
          "exercises": [
            {
              "type": "multiple_choice",
              "question": "Which rivet type is installed from one side only?",
              "options": [
                {
                  "text": "Solid rivet",
                  "is_correct": false
                },
                {
                  "text": "Blind (pop) rivet",
                  "is_correct": true
                },
                {
                  "text": "Factory rivet",
                  "is_correct": false
                }
              ],
              "explanation": "Blind rivets are ideal for hollow sections."
            },
            {
              "type": "fill_in_the_blank",
              "question": "Solid rivets have a (1) ____ head and a (2) ____ head.",
              "blanks": [
                {
                  "position": 1,
                  "answer": "factory"
                },
                {
                  "position": 2,
                  "answer": "shop"
                }
              ],
              "accepted_answers": [
                [
                  "factory",
                  "shop"
                ]
              ],
              "explanation": "Textbook 27.2 verification."
            },
            {
              "type": "multiple_choice",
              "question": "Which rivet is used for hollow sections?",
              "options": [
                {
                  "text": "Solid rivet",
                  "is_correct": false
                },
                {
                  "text": "Blind rivet",
                  "is_correct": true
                },
                {
                  "text": "Factory rivet",
                  "is_correct": false
                }
              ],
              "explanation": "Blind (pop) rivets can be installed from one side."
            }
          ]
        }
      ]
    },
    {
      "id": "unit_28",
      "title": "Unit 28: Non-mechanical joints 1",
      "lessons": [
        {
          "id": "u28_l1",
          "title": "Welding principles",
          "theory": "Joining by melting and fusion:\n\n* **Fusion**: Material from each component is mixed in the **weld pool**.\n* **Base metal**: The metal the components are made of.\n* **Filler**: New material added to the joint.\n* **Heat-affected zone (HAZ)**: Material close to the weld modified by heat.\n* **Residual stress**: Tension 'trapped' around the joint after cooling.",
          "exercises": [
            {
              "type": "fill_in_the_blank",
              "question": "The metal being joined is the (1) ____ metal. The joint is called the (2) ____ pool. Tension trapped after cooling is (3) ____ stress.",
              "blanks": [
                {
                  "position": 1,
                  "answer": "base"
                },
                {
                  "position": 2,
                  "answer": "weld"
                },
                {
                  "position": 3,
                  "answer": "residual"
                }
              ],
              "accepted_answers": [
                [
                  "base",
                  "weld",
                  "residual"
                ]
              ],
              "explanation": "Welding involves complex physical changes in the material."
            },
            {
              "type": "multiple_choice",
              "question": "Joining by melting and fusion creates a:",
              "options": [
                {
                  "text": "Weld pool",
                  "is_correct": true
                },
                {
                  "text": "Screw joint",
                  "is_correct": false
                },
                {
                  "text": "Adhesive bond",
                  "is_correct": false
                }
              ],
              "explanation": "Welding fuses metals in a molten pool."
            },
            {
              "type": "multiple_choice",
              "question": "Material close to the weld modified by heat is the:",
              "options": [
                {
                  "text": "Weld pool",
                  "is_correct": false
                },
                {
                  "text": "HAZ",
                  "is_correct": true
                },
                {
                  "text": "Base metal",
                  "is_correct": false
                }
              ],
              "explanation": "HAZ stands for Heat-Affected Zone."
            },
            {
              "type": "multiple_choice",
              "question": "What is the pool of molten metal in welding called?",
              "options": [
                {
                  "text": "Flux",
                  "is_correct": false
                },
                {
                  "text": "Weld pool",
                  "is_correct": true
                },
                {
                  "text": "Die",
                  "is_correct": false
                }
              ],
              "explanation": "The weld pool is where the metal fuses."
            }
          ]
        },
        {
          "id": "u28_l2",
          "title": "Welding techniques",
          "theory": "Common arc and gas methods:\n\n* **SMAW** (**Stick welding**): Uses a consumable **electrode** (rod) coated in **flux**.\n* **Gas welding**: Uses **oxyacetylene** torch; requires no flux (CO2 acts as shielding gas).\n* **MIG welding** (GMAW): Uses a wire electrode and a separate shielding gas (e.g., argon).\n* **TIG welding** (GTAW): Uses a **non-consumable** tungsten electrode and separate filler rod.",
          "exercises": [
            {
              "type": "matching",
              "question": "Match the welding technique:",
              "pairs": [
                {
                  "left": "SMAW",
                  "right": "Stick welding with flux-coated electrode"
                },
                {
                  "left": "MIG",
                  "right": "Wire electrode + Argon gas"
                },
                {
                  "left": "TIG",
                  "right": "Non-consumable tungsten electrode"
                }
              ],
              "explanation": "Different arc welding methods offer different control and speed."
            },
            {
              "type": "fill_in_the_blank",
              "question": "SMAW uses (1) ____-coated electrodes. TIG uses (2) ____-consumable electrodes.",
              "blanks": [
                {
                  "position": 1,
                  "answer": "flux"
                },
                {
                  "position": 2,
                  "answer": "non"
                }
              ],
              "accepted_answers": [
                [
                  "flux",
                  "non"
                ]
              ],
              "explanation": "Textbook 28.2 verification."
            },
            {
              "type": "multiple_choice",
              "question": "Which welding uses a non-consumable electrode?",
              "options": [
                {
                  "text": "MIG",
                  "is_correct": false
                },
                {
                  "text": "TIG",
                  "is_correct": true
                },
                {
                  "text": "SMAW",
                  "is_correct": false
                }
              ],
              "explanation": "TIG (Tungsten Inert Gas) welding uses a non-consumable tungsten electrode."
            }
          ]
        }
      ]
    },
    {
      "id": "unit_29",
      "title": "Unit 29: Non-mechanical joints 2",
      "lessons": [
        {
          "id": "u29_l1",
          "title": "Specialized welding and brazing",
          "theory": "Other joining methods:\n\n* **Resistance welding**: Passing current through components (e.g., **spot** or **seam** welding).\n* **Ultrasonic welding**: Using high-frequency sound vibrations to fuse parts (common for plastics).\n* **Brazing**: Melting brass filler; base metal is **not** melted. Joint is weaker than a weld.\n* **Soldering**: Using low-temperature filler (solder). **Soft soldering** uses a **soldering iron**.",
          "exercises": [
            {
              "type": "multiple_choice",
              "question": "Which process uses a soldering iron?",
              "options": [
                {
                  "text": "Brazing",
                  "is_correct": false
                },
                {
                  "text": "Soft soldering",
                  "is_correct": true
                },
                {
                  "text": "Ultrasonic welding",
                  "is_correct": false
                }
              ],
              "explanation": "Soft soldering uses low temperatures and a soldering iron."
            },
            {
              "type": "multiple_choice",
              "question": "What uses high-frequency sound vibrations?",
              "options": [
                {
                  "text": "Resistance welding",
                  "is_correct": false
                },
                {
                  "text": "Ultrasonic welding",
                  "is_correct": true
                },
                {
                  "text": "Brazing",
                  "is_correct": false
                }
              ],
              "explanation": "Ultrasonic welding is common for plastics."
            },
            {
              "type": "multiple_choice",
              "question": "Which process joins metals at lower temperatures than welding?",
              "options": [
                {
                  "text": "Brazing",
                  "is_correct": true
                },
                {
                  "text": "Forging",
                  "is_correct": false
                },
                {
                  "text": "Sintering",
                  "is_correct": false
                }
              ],
              "explanation": "Brazing uses a filler metal with a lower melting point."
            }
          ]
        },
        {
          "id": "u29_l2",
          "title": "Adhesives",
          "theory": "Permanently joining with 'glue':\n\n* **Adhere**: Sticking to a surface.\n* **Bond**: The permanent connection (mechanical or chemical).\n* **Substrate**: The material below the surface.\n* **Solvent**: Liquid that evaporates as the adhesive hardens.\n* **Two-part adhesives**: Separate chemicals (e.g., epoxy) that **cure** when mixed.\n* **Contact adhesives**: Applied to both parts and left to dry before touching.",
          "exercises": [
            {
              "type": "fill_in_the_blank",
              "question": "Adhesives must (1) ____ to a (2) ____ to form a (3) ____. (4) ____ adhesives must be mixed and then (5) ____.",
              "blanks": [
                {
                  "position": 1,
                  "answer": "adhere"
                },
                {
                  "position": 2,
                  "answer": "substrate"
                },
                {
                  "position": 3,
                  "answer": "bond"
                },
                {
                  "position": 4,
                  "answer": "Two-part"
                },
                {
                  "position": 5,
                  "answer": "cure"
                }
              ],
              "accepted_answers": [
                [
                  "adhere",
                  "substrate",
                  "bond",
                  "Two-part",
                  "cure"
                ]
              ],
              "explanation": "Adhesives rely on surface adherence and curing."
            },
            {
              "type": "fill_in_the_blank",
              "question": "Evaporating liquid is a (1) ____. Two-part adhesives (2) ____ via reaction. Both sides dry before (3) ____ adhesives.",
              "blanks": [
                {
                  "position": 1,
                  "answer": "solvent"
                },
                {
                  "position": 2,
                  "answer": "cure"
                },
                {
                  "position": 3,
                  "answer": "contact"
                }
              ],
              "accepted_answers": [
                [
                  "solvent",
                  "cure",
                  "contact"
                ]
              ],
              "explanation": "Textbook 29.2 verification."
            },
            {
              "type": "multiple_choice",
              "question": "Which adhesive is applied to both surfaces and left to dry?",
              "options": [
                {
                  "text": "Epoxy",
                  "is_correct": false
                },
                {
                  "text": "Contact adhesive",
                  "is_correct": true
                },
                {
                  "text": "Solvent",
                  "is_correct": false
                }
              ],
              "explanation": "Contact adhesives bond on contact after drying."
            },
            {
              "type": "multiple_choice",
              "question": "What happens when two-part adhesives mix?",
              "options": [
                {
                  "text": "They evaporate",
                  "is_correct": false
                },
                {
                  "text": "They cure",
                  "is_correct": true
                },
                {
                  "text": "They dissolve",
                  "is_correct": false
                }
              ],
              "explanation": "Curing is the chemical reaction that sets the adhesive."
