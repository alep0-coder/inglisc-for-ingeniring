                },
                {
                  "left": "Socket head",
                  "right": "Allen key"
                },
                {
                  "left": "Nut",
                  "right": "Screwed onto threaded shaft"
                }
              ],
              "explanation": "Specific tools are required for different fastener heads."
            },
            {
              "type": "fill_in_the_blank",
              "question": "Threaded shaft is the (1) ____. Turning tool is a (2) ____ or (3) ____.",
              "blanks": [
                {
                  "position": 1,
                  "answer": "shank"
                },
                {
                  "position": 2,
                  "answer": "spanner"
                },
                {
                  "position": 3,
                  "answer": "wrench"
                }
              ],
              "accepted_answers": [
