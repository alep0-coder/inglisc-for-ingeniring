    {
      "id": "unit_38",
      "title": "Unit 38: Fluid pressure",
      "lessons": [
        {
          "id": "u38_l1",
          "title": "Gauge and absolute pressure",
          "theory": "Measuring pressure:\n\n* **Pascal (Pa)**: SI unit (1 N/m²).\n* **Bar**: Roughly equal to atmospheric pressure.\n* **Gauge pressure**: Pressure relative to the atmosphere (differential).\n* **Absolute pressure**: Pressure relative to a perfect vacuum.\n* **Positive pressure**: Higher than atmosphere; **Negative pressure**: Lower than atmosphere (vacuum).",
          "exercises": [
            {
              "type": "multiple_choice",
              "question": "What is pressure relative to the atmosphere?",
              "options": [
                {
                  "text": "Absolute pressure",
                  "is_correct": false
                },
                {
                  "text": "Gauge pressure",
                  "is_correct": true
                },
                {
                  "text": "Vacuum",
                  "is_correct": false
                }
              ],
              "explanation": "Gauge pressure is the differential relative to atmospheric pressure."
            },
            {
              "type": "fill_in_the_blank",
              "question": "Takeoff (1) ____ pressure is zero. Flight uses (2) ____ air. Vacuum is (3) ____ gauge pressure.",
