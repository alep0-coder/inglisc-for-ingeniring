                },
                {
                  "term": "Check that both diagonals are equal",
                  "definition": "To check that corners are right-angles"
                },
                {
                  "term": "Measure from parallel gridlines",
                  "definition": "To double-check your measurements"
                },
                {
                  "term": "Add up chain dimensions",
                  "definition": "To prevent slight errors being multiplied"
                }
              ],
              "hint": "Think about accuracy and potential errors.",
              "explanation": "These precautions ensure the site matches the drawings perfectly."
            }
          ]
        }
