    {
      "id": "unit_25",
      "title": "Unit 25: Interconnecting components",
      "lessons": [
        {
          "id": "u25_l1",
          "title": "Attaching and supporting",
          "theory": "Components in assemblies are connected in various ways:\n\n* **Supported**: Preventing downward movement.\n* **Anchored**: Holding in position to stop sliding or lifting.\n* **Embedded**: Surrounded and held (e.g., bolts in concrete).\n* **Joint / Connection**: The point where components meet.\n* **Fastened together / Fixed**: Securely joined using fasteners.",
          "exercises": [
            {
              "type": "fill_in_the_blank",
              "question": "Components can be (1) ____ (preventing downward movement), (2) ____ (stopping sliding), or (3) ____ (surrounded and held).",
              "blanks": [
                {
                  "position": 1,
                  "answer": "supported"
                },
                {
                  "position": 2,
                  "answer": "anchored"
                },
                {
                  "position": 3,
                  "answer": "embedded"
                }
              ],
              "accepted_answers": [
                [
                  "supported",
                  "anchored",
                  "embedded"
                ]
              ],
              "explanation": "Proper interconnection is vital for structural integrity."
            },
            {
              "type": "matching",
              "question": "Match the structural connection:",
              "pairs": [
                {
                  "left": "Supported",
                  "right": "Preventing downward movement"
                },
                {
                  "left": "Anchored",
                  "right": "Holding in position"
                },
                {
                  "left": "Embedded",
                  "right": "Surrounded and held"
                }
              ],
              "explanation": "Structural connection terms."
            },
            {
              "type": "multiple_choice",
              "question": "What prevents components from sliding?",
              "options": [
                {
                  "text": "Supporting",
                  "is_correct": false
                },
                {
                  "text": "Anchoring",
                  "is_correct": true
                },
                {
                  "text": "Embedding",
                  "is_correct": false
                }
              ],
              "explanation": "Anchoring holds a component in position."
            },
            {
              "type": "multiple_choice",
              "question": "What stops components from moving downward?",
              "options": [
                {
                  "text": "Anchoring",
                  "is_correct": false
                },
                {
                  "text": "Supporting",
                  "is_correct": true
                },
                {
                  "text": "Sealing",
                  "is_correct": false
                }
              ],
              "explanation": "Support prevents downward motion."
            }
          ]
        },
        {
          "id": "u25_l2",
          "title": "Fitting and adjustment",
          "theory": "Ensuring components fit properly:\n\n* **Play**: The amount of free movement allowed in a joint.\n* **Adjusted**: Moved as required for alignment.\n* **Slot through**: Passing a component through a hole.\n* **Fit together**: Correct matching of parts.\n* **Sealed**: Protected against environmental factors (e.g., rainwater).",
          "exercises": [
            {
              "type": "multiple_choice",
              "question": "What is the amount of free movement allowed in a joint?",
