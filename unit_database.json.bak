                {
                  "left": "Cutting fluid",
                  "right": "Coolant pumped onto workpiece"
                },
                {
                  "left": "Workpiece",
                  "right": "Material being shaped"
                }
              ],
              "explanation": "Machining terms describe the process and its by-products."
            },
