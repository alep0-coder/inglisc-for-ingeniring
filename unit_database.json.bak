                {
                  "position": 1,
                  "answer": "gauge"
                },
                {
                  "position": 2,
                  "answer": "compressed"
                },
                {
                  "position": 3,
                  "answer": "negative"
                }
              ],
              "accepted_answers": [
                [
                  "gauge",
                  "compressed",
                  "negative"
                ]
              ],
              "explanation": "Textbook 38.1 verification."
            },
            {
              "type": "fill_in_the_blank",
