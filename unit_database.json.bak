              "accepted_answers": [
                [
                  "set"
                ]
              ],
              "hint": "A group of related items.",
              "explanation": "A set of drawings consists of a number of related drawings."
            },
            {
              "type": "fill_in_the_blank",
              "question": "Most drawings are produced on computers, using ____ software.",
              "blanks": [
                {
                  "position": 1,
                  "answer": "CAD"
                }
