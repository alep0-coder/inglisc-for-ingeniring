        {
          "id": "u5_l3",
          "title": "Accuracy and checks",
          "theory": "To prevent mistakes, always use a steel tape measure (it does not stretch). Check that both diagonals of a rectangle are equal to ensure corners are right-angles. Measure in two directions to **double-check**.",
          "exercises": [
