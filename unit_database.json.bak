                }
              ],
              "accepted_answers": [
                [
                  "variation"
                ],
                [
                  "range"
                ]
              ],
              "hint": "The total spread.",
              "explanation": "Variation or range is the difference between extremes."
            },
            {
              "type": "fill_in_the_blank",
              "question": "An acceptable deviation: ____",
              "blanks": [
                {
                  "position": 1,
                  "answer": "within tolerance"
                }
              ],
              "accepted_answers": [
                [
                  "within tolerance"
                ]
              ],
              "hint": "Inside the limits.",
              "explanation": "Within tolerance means the size is allowed."
            },
            {
              "type": "fill_in_the_blank",
              "question": "An unacceptable deviation: ____",
              "blanks": [
                {
                  "position": 1,
                  "answer": "outside tolerance"
                }
              ],
              "accepted_answers": [
                [
                  "outside tolerance"
                ]
              ],
              "hint": "Beyond the limits.",
              "explanation": "Outside tolerance means the size is rejected."
            },
            {
              "type": "fill_in_the_blank",
              "question": "Little deviation allowed: ____",
              "blanks": [
                {
                  "position": 1,
                  "answer": "tight tolerance"
                }
              ],
              "accepted_answers": [
                [
                  "tight tolerance"
                ],
                [
