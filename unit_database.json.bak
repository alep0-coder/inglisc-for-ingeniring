    {
      "id": "unit_2",
      "title": "Unit 2: Design development",
      "lessons": [
        {
          "id": "u2_l1",
          "title": "Initial design phase",
          "theory": "The design process begins with a **design brief** – a list of essential requirements from the client. \n\nFrom this brief, designers create a **concept** (an overall design idea) and produce **rough sketches** (hand-drawn illustrations). As the design develops, these sketches are refined into **preliminary drawings** which can be assessed in more detail.",
          "exercises": [
            {
              "type": "fill_in_the_blank",
              "question": "A description of design objectives is a ____.",
              "blanks": [
                {
                  "position": 1,
                  "answer": "design brief"
                }
              ],
              "accepted_answers": [
                [
                  "design brief"
                ]
              ],
              "hint": "The first document from the client.",
              "explanation": "A design brief outlines the requirements for a project."
            },
            {
              "type": "fill_in_the_blank",
              "question": "A rough, hand-drawn illustration is a ____.",
              "blanks": [
                {
                  "position": 1,
                  "answer": "sketch"
                }
              ],
              "accepted_answers": [
                [
                  "sketch"
                ]
              ],
              "hint": "Drawn quickly by hand.",
              "explanation": "Sketches are rough illustrations used in early stages."
            },
            {
              "type": "fill_in_the_blank",
              "question": "An initial diagram, requiring further development, is a ____.",
              "blanks": [
                {
                  "position": 1,
                  "answer": "preliminary drawing"
                }
              ],
              "accepted_answers": [
                [
                  "preliminary drawing"
                ]
              ],
              "hint": "Comes after the sketch.",
              "explanation": "Preliminary drawings are developed from sketches."
            },
            {
              "type": "fill_in_the_blank",
              "question": "An overall design idea is a ____.",
              "blanks": [
                {
                  "position": 1,
                  "answer": "concept"
                }
              ],
              "accepted_answers": [
                [
                  "concept"
                ]
              ],
              "hint": "The big idea.",
              "explanation": "A concept is the overall design idea."
            }
          ]
        },
        {
          "id": "u2_l2",
          "title": "Collaborative development",
          "theory": "In large projects, drawings are **issued** or **circulated** (distributed) to the team. They are often **revised**, **amended**, or **redesigned** (changed) following comments. \n\nEach **revision** is numbered. For example, drawing 110A becomes 110B. Revision B is then the **current** drawing, and A is **superseded** (replaced). \n\nOnce a preliminary drawing is approved, a senior engineer will **sign off** (authorize) it, turning it into a **working drawing** that the production or construction team can **work to**.",
          "exercises": [
            {
              "type": "matching",
              "question": "Match the verbs with similar meanings.",
              "pairs": [
                {
                  "term": "Change/Improve",
                  "definition": "Amend, Redesign, Refine, Revise"
                },
                {
                  "term": "Send out/Distribute",
                  "definition": "Circulate, Issue"
                },
                {
                  "term": "Accept/Agree",
                  "definition": "Approve, Sign off"
                },
                {
                  "term": "Replace",
                  "definition": "Supersede"
                }
              ],
              "hint": "Group the engineering verbs.",
              "explanation": "These verbs describe different stages of managing drawings."
            },
            {
              "type": "fill_in_the_blank",
              "question": "Has the drawing been revised, or is this the first ____? (draft/refine)",
              "blanks": [
                {
                  "position": 1,
                  "answer": "draft"
                }
              ],
              "accepted_answers": [
                [
                  "draft"
                ]
              ],
              "hint": "The very first version.",
              "explanation": "A draft is the initial version of a document."
            },
            {
              "type": "fill_in_the_blank",
              "question": "This has been superseded. It's not the ____ drawing. (current/preliminary)",
              "blanks": [
                {
                  "position": 1,
                  "answer": "current"
                }
              ],
              "accepted_answers": [
                [
                  "current"
                ]
              ],
              "hint": "The one in use now.",
              "explanation": "The current drawing is the most up-to-date version."
            },
            {
              "type": "fill_in_the_blank",
              "question": "Has this drawing been signed off? Can they ____ to it in the factory? (circulate/work)",
              "blanks": [
                {
                  "position": 1,
                  "answer": "work"
                }
              ],
              "accepted_answers": [
                [
                  "work"
                ]
              ],
              "hint": "Follow the instructions on the drawing.",
              "explanation": "To 'work to' a drawing means to build according to its specifications."
            },
            {
              "type": "fill_in_the_blank",
              "question": "I still need to ____ on the latest set of drawings. (comment/note)",
              "blanks": [
                {
                  "position": 1,
                  "answer": "comment"
                }
              ],
              "accepted_answers": [
                [
                  "comment"
                ]
              ],
              "hint": "Provide feedback.",
              "explanation": "Team members comment on drawings to suggest changes."
            },
            {
              "type": "fill_in_the_blank",
              "question": "Construction can't start until the first ____ drawings have been issued. (current/working)",
              "blanks": [
                {
                  "position": 1,
                  "answer": "working"
                }
              ],
              "accepted_answers": [
                [
                  "working"
                ]
              ],
              "hint": "Final authorized drawings.",
              "explanation": "Working drawings are the authorized versions for production."
            }
          ]
        },
        {
          "id": "u2_l3",
          "title": "Revision management in practice",
          "theory": "Each drawing has a revision history. When an **amendment** is made, the **revision** letter changes. **Notes** in the right-hand column detail the changes made. When a new version is **issued**, the previous one is **superseded**.",
          "exercises": [
            {
              "type": "fill_in_the_blank",
              "question": "There seems to be a problem with dwg 1120, which you ____ yesterday.",
              "blanks": [
                {
                  "position": 1,
                  "answer": "issued"
                }
              ],
              "accepted_answers": [
                [
                  "issued"
                ]
              ],
              "hint": "Sent out.",
              "explanation": "Drawings are issued to the team."
            },
            {
              "type": "fill_in_the_blank",
              "question": "The drawing is marked as ____ C, but there are no notes...",
              "blanks": [
                {
                  "position": 1,
                  "answer": "revision"
                }
              ],
              "accepted_answers": [
                [
                  "revision"
                ]
              ],
              "hint": "The version letter.",
              "explanation": "Each change creates a new revision."
            },
            {
              "type": "fill_in_the_blank",
              "question": "...detailing the ____ made.",
              "blanks": [
                {
                  "position": 1,
                  "answer": "amendments"
                }
              ],
              "accepted_answers": [
                [
                  "amendments"
                ]
              ],
              "hint": "Changes.",
              "explanation": "Amendments are the specific changes recorded."
            },
            {
              "type": "fill_in_the_blank",
              "question": "And on the actual drawing, there are no visible differences from the first ____.",
              "blanks": [
                {
                  "position": 1,
                  "answer": "draft"
                }
              ],
              "accepted_answers": [
                [
                  "draft"
                ]
              ],
              "hint": "Initial version.",
              "explanation": "The first version is called the draft."
            },
            {
              "type": "fill_in_the_blank",
              "question": "Has the ____ version (1120B) been sent accidently?",
              "blanks": [
                {
                  "position": 1,
                  "answer": "superseded"
                }
              ],
              "accepted_answers": [
                [
                  "superseded"
                ]
              ],
              "hint": "The previous, replaced version.",
              "explanation": "When a new revision is issued, the old one is superseded."
            },
            {
              "type": "fill_in_the_blank",
              "question": "Please advise asap, as we are assuming this is not the ____ drawing...",
              "blanks": [
                {
                  "position": 1,
                  "answer": "current"
                }
              ],
              "accepted_answers": [
                [
                  "current"
                ]
              ],
              "hint": "The latest valid version.",
              "explanation": "The current drawing is the one that should be used."
            },
            {
              "type": "fill_in_the_blank",
              "question": "...and I have therefore told the fabrication team not to ____ to it.",
              "blanks": [
                {
                  "position": 1,
                  "answer": "work"
                }
              ],
              "accepted_answers": [
                [
                  "work"
                ]
              ],
              "hint": "Build according to it.",
              "explanation": "Teams work to current drawings."
            }
          ]
        }
      ]
    },
    {
      "id": "unit_3",
      "title": "Unit 3: Design solutions",
      "lessons": [
        {
          "id": "u3_l1",
          "title": "Design objectives",
          "theory": "A **design brief** for a **proposed** product consists of several key elements:\n\n* **Function**: The product's intended use (what it is designed to do), including performance targets.\n* **Constraints**: Limits on the design (e.g., maximum size or weight limit).\n* **Comparative targets**: How well the product performs compared with **existing models**.\n* **Design features**: Specific things the design must have (e.g., a lock).\n* **Budget**: The cost limits that must not be exceeded to make the design **cost-effective**.\n\nThe goal is to produce a **design solution** that meets all technical objectives.",
          "exercises": [
            {
              "type": "fill_in_the_blank",
              "question": "Cost limitations are always a ____!",
              "blanks": [
                {
                  "position": 1,
                  "answer": "constraint"
                }
              ],
              "accepted_answers": [
                [
                  "constraint"
                ]
              ],
              "hint": "A limit on the design.",
              "explanation": "Constraints are limits or restrictions on a design."
            },
            {
              "type": "fill_in_the_blank",
              "question": "A ____ has been allocated for the preliminary design phase.",
              "blanks": [
                {
                  "position": 1,
                  "answer": "budget"
                }
              ],
              "accepted_answers": [
                [
                  "budget"
                ]
              ],
              "hint": "Financial allocation.",
              "explanation": "A budget is the allocated cost for a project."
            },
            {
              "type": "fill_in_the_blank",
              "question": "But we mustn't ____ that amount.",
              "blanks": [
                {
                  "position": 1,
                  "answer": "exceed"
                }
              ],
              "accepted_answers": [
                [
                  "exceed"
                ]
              ],
              "hint": "Go over.",
              "explanation": "Costs should not exceed the budget."
            },
            {
              "type": "fill_in_the_blank",
              "question": "If we spend more than we earn, that's not a ____ design solution.",
              "blanks": [
                {
                  "position": 1,
                  "answer": "cost-effective"
                }
              ],
              "accepted_answers": [
                [
                  "cost-effective"
                ]
              ],
              "hint": "Financially viable.",
              "explanation": "Cost-effective means producing a good result without wasting money."
            },
            {
              "type": "fill_in_the_blank",
              "question": "The ____ of this detector is to locate underground cables.",
              "blanks": [
                {
                  "position": 1,
                  "answer": "function"
                }
              ],
              "accepted_answers": [
                [
                  "function"
                ]
              ],
              "hint": "What it is designed to do.",
              "explanation": "Function describes the purpose of a product."
            },
            {
              "type": "fill_in_the_blank",
              "question": "Since it's ____ to be used in noisy environments, the earphone is an important ____.",
              "blanks": [
                {
                  "position": 1,
                  "answer": "designed"
                },
                {
                  "position": 2,
                  "answer": "feature"
                }
              ],
              "accepted_answers": [
                [
                  "designed",
                  "feature"
                ]
              ],
              "hint": "Intended use and specific component.",
              "explanation": "Products are designed for specific contexts and have specific features."
            },
            {
              "type": "fill_in_the_blank",
              "question": "Are these already on the market - are they ____ products?",
              "blanks": [
                {
                  "position": 1,
                  "answer": "existing"
                }
              ],
              "accepted_answers": [
                [
                  "existing"
                ]
              ],
              "hint": "Currently available.",
              "explanation": "Existing products are those already on the market."
            },
            {
              "type": "fill_in_the_blank",
              "question": "Or are we talking about ____ products that are still under development?",
