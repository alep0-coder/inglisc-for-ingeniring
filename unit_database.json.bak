                  "position": 1,
                  "answer": "Thermal"
                },
                {
                  "position": 2,
                  "answer": "expand"
                },
                {
                  "position": 3,
                  "answer": "contract"
                },
                {
                  "position": 4,
                  "answer": "thermal"
                }
              ],
              "accepted_answers": [
                [
                  "Thermal",
                  "expand",
                  "contract",
                  "thermal"
                ]
              ],
              "explanation": "Thermal properties are critical in engine and wiring design."
            },
            {
              "type": "multiple_choice",
              "question": "Copper is an excellent thermal:",
