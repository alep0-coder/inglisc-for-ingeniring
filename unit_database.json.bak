    {
      "id": "unit_39",
      "title": "Unit 39: Fluid dynamics",
      "lessons": [
        {
          "id": "u39_l1",
          "title": "Aerodynamics and drag",
          "theory": "Flow around objects:\n\n* **Aerodynamics**: Fluid dynamics concerned with airflow.\n* **Drag**: Resistance to airflow (**Form drag**, **Skin friction**).\n* **Streamlined**: Having a low drag coefficient.\n* **Slipstream**: Low-pressure zone behind a moving object.\n* **Wake**: The turbulent zone behind an object containing **vortices**.",
          "exercises": [
            {
              "type": "matching",
              "question": "Match the aerodynamic force/zone:",
              "pairs": [
                {
                  "left": "Drag",
                  "right": "Resistance to airflow"
                },
                {
                  "left": "Slipstream",
                  "right": "Low-pressure zone behind object"
                },
                {
                  "left": "Wake",
                  "right": "Turbulent zone with vortices"
                }
              ],
              "explanation": "Aerodynamic design focuses on managing these forces."
            },
            {
              "type": "multiple_choice",
              "question": "Smooth airflow is called:",
              "options": [
                {
                  "text": "Turbulent flow",
                  "is_correct": false
                },
                {
                  "text": "Laminar flow",
                  "is_correct": true
                },
                {
                  "text": "Boundary layer",
                  "is_correct": false
                }
              ],
              "explanation": "Laminar flow follows a smooth, direct path."
            },
            {
              "type": "multiple_choice",
              "question": "What is air resistance called?",
