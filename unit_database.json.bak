    {
      "id": "unit_18",
      "title": "Unit 18: Material properties 1",
      "lessons": [
        {
          "id": "u18_l1",
          "title": "Tensile strength and deformation",
          "theory": "Materials react to forces:\n\n* **Tension**: Stretching forces. Causes **extension** or **elongation**.\n* **Compression**: Crushing forces.\n* **Deformation**: Change in shape due to force.\n* **Tensile strength**: Ability to resist tension.\n* **Compressive strength**: Ability to resist compression.",
          "exercises": [
            {
              "type": "fill_in_the_blank",
              "question": "Tensile strength is the ability to resist (1) ____. Extension is also called (2) ____. Materials that change shape under force (3) ____.",
              "blanks": [
                {
                  "position": 1,
                  "answer": "tension"
                },
                {
                  "position": 2,
                  "answer": "elongation"
                },
                {
                  "position": 3,
                  "answer": "deform"
                }
              ],
              "accepted_answers": [
                [
                  "tension",
                  "elongation",
                  "deform"
                ]
              ],
              "explanation": "Materials react to forces by changing shape."
            },
            {
              "type": "fill_in_the_blank",
              "question": "18.1: A crushing force is (1) ____. Stretched into long lengths means it is (2) ____.",
              "blanks": [
                {
                  "position": 1,
                  "answer": "compression"
                },
                {
                  "position": 2,
                  "answer": "ductile"
                }
              ],
              "accepted_answers": [
                [
                  "compression",
                  "ductile"
                ]
              ],
              "explanation": "Textbook 18.1/18.2 verification."
            },
            {
              "type": "multiple_choice",
              "question": "Which property describes a material that fractures easily?",
              "options": [
                {
                  "text": "Stiff",
                  "is_correct": false
                },
                {
                  "text": "Brittle",
                  "is_correct": true
                },
                {
                  "text": "Plastic",
                  "is_correct": false
                }
              ],
              "explanation": "Brittle materials have low elasticity and fracture easily."
            },
            {
              "type": "multiple_choice",
              "question": "What is a materials ability to return to its shape called?",
              "options": [
                {
                  "text": "Plasticity",
                  "is_correct": false
                },
                {
                  "text": "Elasticity",
                  "is_correct": true
                },
                {
                  "text": "Ductility",
                  "is_correct": false
                }
              ],
              "explanation": "Elasticity allows return to original shape."
            }
          ]
        },
        {
          "id": "u18_l2",
          "title": "Elastic and plastic deformation",
          "theory": "Materials go through stages of deformation:\n\n* **Proportional extension**: Length increases linearly with tension.\n* **Elastic limit**: The point beyond which a material will not return to its original shape.\n* **Yield point**: The point where the material begins to flow and extend significantly without added force.\n* **UTS (Ultimate Tensile Strength)**: The maximum tension a material can withstand before breaking.",
          "exercises": [
            {
              "type": "multiple_choice",
              "question": "What is the point beyond which a material will NOT return to its original length?",
              "options": [
                {
                  "text": "Limit of proportionality",
                  "is_correct": false
                },
                {
                  "text": "Elastic limit",
                  "is_correct": true
                },
                {
                  "text": "Yield point",
                  "is_correct": false
                }
              ],
              "explanation": "The elastic limit marks the transition from elastic to plastic deformation."
            },
            {
              "type": "multiple_choice",
              "question": "A material that can be hammered into shape is:",
              "options": [
                {
                  "text": "Ductile",
                  "is_correct": false
                },
                {
                  "text": "Malleable",
                  "is_correct": true
                },
                {
                  "text": "Brittle",
                  "is_correct": false
                }
              ],
              "explanation": "Malleability is the ability to be deformed by compression."
            },
            {
              "type": "multiple_choice",
              "question": "What is the maximum stress a material can withstand called?",
              "options": [
                {
                  "text": "Elastic limit",
                  "is_correct": false
                },
                {
                  "text": "UTS",
                  "is_correct": true
                },
                {
                  "text": "Yield point",
                  "is_correct": false
                }
              ],
              "explanation": "UTS stands for Ultimate Tensile Strength."
            },
            {
              "type": "multiple_choice",
              "question": "What is a narrower section appearing in a bar during testing?",
              "options": [
                {
                  "text": "Waist",
                  "is_correct": true
                },
                {
                  "text": "Kerf",
                  "is_correct": false
                },
                {
                  "text": "Bore",
                  "is_correct": false
                }
              ],
              "explanation": "A waist signals that the bar is about to fracture."
            }
          ]
        }
      ]
    },
    {
      "id": "unit_19",
      "title": "Unit 19: Material properties 2",
      "lessons": [
        {
          "id": "u19_l1",
          "title": "Hardness, fatigue and creep",
          "theory": "Durability depends on several factors:\n\n* **Indentation hardness**: Resistance to impacts (preventing dents).\n* **Scratch hardness**: Resistance to surface scratches; related to **abrasion resistance**.\n* **Fatigue**: Caused by **cyclic loads** (varying forces). Results in **micro-cracking**.\n* **Fracture toughness**: Measure of how easily existing cracks open up.\n* **Creep**: Permanent deformation due to sustained loads over time, worsened by heat.",
          "exercises": [
            {
              "type": "matching",
              "question": "Match the hardness type:",
              "pairs": [
                {
                  "left": "Scratch hardness",
                  "right": "Resisting being scratched (abrasion)"
                },
                {
                  "left": "Indentation hardness",
                  "right": "Resisting compressions from impacts"
                },
                {
                  "left": "Durability",
                  "right": "How long a material will last"
                }
              ],
              "explanation": "Hardness affects the durability of a material."
            },
            {
              "type": "fill_in_the_blank",
              "question": "19.2: Wing flex causes (1) ____ loads. Small cracks are (2) ____. Resistance to opening cracks is (3) ____ toughness.",
              "blanks": [
                {
                  "position": 1,
                  "answer": "cyclic"
                },
                {
                  "position": 2,
                  "answer": "micro-cracking"
                },
                {
                  "position": 3,
                  "answer": "fracture"
                }
              ],
              "accepted_answers": [
                [
                  "cyclic",
                  "micro-cracking",
                  "fracture"
                ]
              ],
              "explanation": "Textbook 19.2 verification."
            },
            {
              "type": "multiple_choice",
              "question": "What is the problem caused by cyclic loads?",
              "options": [
                {
                  "text": "Creep",
                  "is_correct": false
                },
                {
                  "text": "Fatigue",
                  "is_correct": true
                },
                {
                  "text": "Corrosion",
                  "is_correct": false
                }
              ],
              "explanation": "Fatigue causes micro-cracking over time."
            },
            {
              "type": "multiple_choice",
              "question": "What is permanent deformation due to loads over time?",
              "options": [
                {
                  "text": "Fatigue",
                  "is_correct": false
                },
                {
                  "text": "Creep",
                  "is_correct": true
                },
                {
                  "text": "Brittleness",
                  "is_correct": false
                }
              ],
              "explanation": "Creep increases over time, especially with heat."
            }
          ]
        },
        {
          "id": "u19_l2",
          "title": "Thermal properties",
          "theory": "How materials handle heat:\n\n* **Thermal conductivity**: Ability to **conduct** (transmit) heat.\n* **Thermal conductor**: Material with high conductivity (e.g., copper).\n* **Thermal insulator**: Material with poor conductivity (e.g., polystyrene).\n* **Expansion** / **Contraction**: Increase/decrease in size due to temperature changes.\n* **Coefficient of thermal expansion**: Change in size per degree of temperature change.",
          "exercises": [
            {
              "type": "fill_in_the_blank",
              "question": "(1) ____ conductivity is the ability to carry heat. Materials (2) ____ when heated and (3) ____ when cooled. This is measured by the coefficient of (4) ____ expansion.",
