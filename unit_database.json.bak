        {
          "id": "u4_l2",
          "title": "Level and plumb",
          "theory": "Measurements are taken along horizontal or vertical planes.\n\n* **Level**: A surface that is both horizontal and flat (smooth).\n* **Flat**: A surface that is smooth, but not necessarily horizontal (it could be vertical or **inclined**).\n* **Plumb**: Faces that are perfectly vertical (like the walls of a building).\n* **Out of plumb**: Structures that are slightly inclined from the vertical.",
          "exercises": [
            {
              "type": "multiple_choice",
              "question": "The height of the towers is measured horizontally.",
              "options": [
                {
                  "text": "True",
                  "is_correct": false
                },
                {
                  "text": "False",
                  "is_correct": true
                }
              ],
              "hint": "Is height horizontal or vertical?",
              "explanation": "False - The height of the towers is measured vertically."
            },
            {
              "type": "multiple_choice",
              "question": "The overall span is measured along the width of the bridge.",
              "options": [
                {
                  "text": "True",
                  "is_correct": false
                },
                {
                  "text": "False",
                  "is_correct": true
                }
              ],
              "hint": "Does span follow the length or width?",
              "explanation": "False - The overall span is measured along the length of the bridge."
            },
            {
              "type": "multiple_choice",
              "question": "The tops of the towers are at different levels, so a horizontal plane striking the top of one tower will not strike the tops of all the others.",
              "options": [
                {
                  "text": "True",
                  "is_correct": true
                },
                {
                  "text": "False",
                  "is_correct": false
                }
              ],
              "hint": "Check the theory about planes striking faces.",
              "explanation": "True - If they are at different levels, a horizontal plane won't hit all tops."
            },
            {
              "type": "multiple_choice",
              "question": "The highest point of the structure is the top extremity of the highest tower.",
              "options": [
                {
                  "text": "True",
                  "is_correct": true
                },
                {
                  "text": "False",
                  "is_correct": false
                }
              ],
              "hint": "Extremity means the furthest point.",
              "explanation": "True - The highest extremity is the highest point."
            },
            {
              "type": "multiple_choice",
              "question": "The thickness of each tower decreases towards the top, so the faces of the towers are plumb.",
              "options": [
                {
                  "text": "True",
                  "is_correct": false
                },
                {
                  "text": "False",
                  "is_correct": true
                }
              ],
              "hint": "If thickness changes, are the faces perfectly vertical?",
              "explanation": "False - The faces are out of plumb because they are inclined."
            },
            {
              "type": "multiple_choice",
              "question": "The greatest thickness of each tower is its internal thickness at its base.",
              "options": [
                {
                  "text": "True",
                  "is_correct": false
                },
                {
                  "text": "False",
                  "is_correct": true
                }
              ],
              "hint": "External vs Internal.",
              "explanation": "False - The greatest thickness is its external thickness at its base."
            }
          ]
        },
        {
