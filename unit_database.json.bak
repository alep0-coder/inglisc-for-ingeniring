              "blanks": [
                {
                  "position": 1,
                  "answer": "absolute"
                },
                {
                  "position": 2,
                  "answer": "positive"
                }
              ],
              "accepted_answers": [
                [
                  "absolute",
                  "positive"
                ]
              ],
              "explanation": "Textbook 38.1 verification."
            },
            {
              "type": "multiple_choice",
              "question": "What is pressure relative to the atmosphere?",
              "options": [
                {
                  "text": "Absolute",
                  "is_correct": false
                },
                {
                  "text": "Gauge",
                  "is_correct": true
                },
                {
                  "text": "Hydrostatic",
                  "is_correct": false
                }
              ],
