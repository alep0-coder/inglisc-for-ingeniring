    {
      "id": "unit_20",
      "title": "Unit 20: Forming, working and heat-treating metal",
      "lessons": [
        {
          "id": "u20_l1",
          "title": "Casting, sintering and extruding",
          "theory": "Metal forming processes:\n\n* **Casting**: Pouring molten metal into a mould (**die**).\n* **Sintering**: Compressing metal powder in a die and heating it (without melting) until particles join.\n* **Extrusion**: Forcing molten metal through a shaping die to form long lengths (bars, tubes).",
          "exercises": [
            {
              "type": "multiple_choice",
              "question": "What process uses metal powder instead of molten metal?",
              "options": [
                {
                  "text": "Casting",
                  "is_correct": false
                },
                {
                  "text": "Sintering",
                  "is_correct": true
                },
                {
                  "text": "Extruding",
                  "is_correct": false
                }
              ],
              "explanation": "Sintering joins metal powder particles due to heat."
            },
            {
              "type": "multiple_choice",
              "question": "What process involves forcing molten metal through a shaping tool?",
              "options": [
                {
                  "text": "Casting",
                  "is_correct": false
                },
                {
                  "text": "Extruding",
                  "is_correct": true
                },
                {
                  "text": "Forging",
                  "is_correct": false
                }
              ],
              "explanation": "Extrusion produces long lengths with a constant section."
            },
            {
              "type": "multiple_choice",
              "question": "What is working metal by hammering it called?",
              "options": [
                {
                  "text": "Casting",
                  "is_correct": false
                },
                {
                  "text": "Forging",
                  "is_correct": true
                },
                {
                  "text": "Extruding",
                  "is_correct": false
                }
              ],
              "explanation": "Forging uses compression to shape metal."
            },
            {
              "type": "multiple_choice",
              "question": "What is heating metal until it is liquid called?",
              "options": [
                {
                  "text": "Sintering",
                  "is_correct": false
                },
                {
                  "text": "Casting",
                  "is_correct": true
                },
                {
                  "text": "Extruding",
                  "is_correct": false
                }
              ],
              "explanation": "Casting involves pouring molten metal into a die."
            }
          ]
        },
        {
          "id": "u20_l2",
          "title": "Working and heat-treating",
          "theory": "Shaping and improving metal properties:\n\n* **Forging** / **Working**: Shaping metal by hammering or rolling (**hot** or **cold**).\n* **Work hardening**: Increased hardness due to cold working.\n* **Shot-peening**: Firing metal balls at a surface to harden it.\n* **Heat treatments**:\n    * **Annealing**: Heating and slow cooling (softens, increases elasticity).\n    * **Quencing**: Rapid cooling (hardens, increases brittleness).\n    * **Tempering**: Heating and holding (balances hardness and elasticity).\n    * **Precipitation hardening** (**age hardening**): Extended tempering for maximum hardness.\n    * **Case hardening**: Hardening only the surface using specific gases.",
          "exercises": [
            {
              "type": "matching",
              "question": "Match the heat treatment:",
              "pairs": [
                {
                  "left": "Quencing",
                  "right": "Rapid cooling in water or oil"
                },
                {
                  "left": "Annealing",
                  "right": "Slow cooling to make it softer"
                },
                {
                  "left": "Tempering",
                  "right": "Balance between hardness and elasticity"
                }
              ],
              "explanation": "Heat treatment changes the atomic structure and properties of metals."
            },
            {
              "type": "fill_in_the_blank",
              "question": "20.2: Forging increases hardness via (1) ____ hardening. Bombarding with balls is (2) ____.",
              "blanks": [
                {
                  "position": 1,
                  "answer": "work"
                },
                {
                  "position": 2,
                  "answer": "shot-peening"
                }
              ],
              "accepted_answers": [
                [
                  "work",
