    {
      "id": "unit_23",
      "title": "Unit 23: Machining 1",
      "lessons": [
        {
          "id": "u23_l1",
          "title": "Machining and CNC",
          "theory": "Machining involves cutting and shaping material (**workpieces**) into components.\n\n* **Machine tools**: Tools used for cutting (e.g., drill bits).\n* **Swarf / Chips**: Waste metal produced.\n* **Cutting fluid / Coolant**: Liquid pumped onto the workpiece to keep it cool.\n* **CNC (Computer Numerical Control)**: Computers guiding the machining process.\n* **CAD/CAM**: Software for design and direct transfer to CNC.",
          "exercises": [
            {
              "type": "matching",
              "question": "Match the machining waste and coolant:",
