                ]
              ],
              "hint": "A small margin.",
              "explanation": "Tight tolerance requires high precision."
            },
            {
              "type": "fill_in_the_blank",
              "question": "Large deviation allowed: ____",
              "blanks": [
                {
                  "position": 1,
                  "answer": "loose tolerance"
                }
              ],
